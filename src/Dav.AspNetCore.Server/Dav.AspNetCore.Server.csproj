<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    
    <PropertyGroup>
        <PackageId>DanielStanus.WebDav.AspNetCore.Server</PackageId>
        <PackageVersion>10.0.0</PackageVersion>
        <Authors>Daniel Calin Stanus</Authors>
        <Company>Daniel Calin Stanus</Company>
        <PackageTags>WebDav;AspNetCore;Asp;Dav;AspNetCore WebDav;AspNetCore Dav;Asp WebDav;Asp Dav</PackageTags>
        <PackageProjectUrl>https://github.com/danielstanus/Dav.AspNetCore.Server</PackageProjectUrl>
        <RepositoryUrl>https://github.com/danielstanus/Dav.AspNetCore.Server</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>Fork of Dav.AspNetCore.Server (MIT) providing a WebDav implementation for ASP.NET Core, updated to .NET 10. Based on the original work by Kevin Scholz.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    
    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

</Project>
