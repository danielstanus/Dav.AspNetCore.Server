<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>DanielStanus.WebDav.AspNetCore.Server.Extensions.SqlServer</PackageId>
        <PackageVersion>1.0.0</PackageVersion>
        <Authors>Daniel Calin Stanus</Authors>
        <Company>Daniel Calin Stanus</Company>
        <PackageTags>WebDav;AspNetCore;Asp;Dav;AspNetCore WebDav;AspNetCore Dav;Asp WebDav;Asp Dav;MSSQL;SqlServer;SQL;ADO</PackageTags>
        <PackageProjectUrl>https://github.com/danielstanus/Dav.AspNetCore.Server</PackageProjectUrl>
        <RepositoryUrl>https://github.com/danielstanus/Dav.AspNetCore.Server</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>SQL Server lock manager and property store for DanielStanus.WebDav.AspNetCore.Server. Based on the original work by Kevin Scholz.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
    
    <PropertyGroup>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Dav.AspNetCore.Server\Dav.AspNetCore.Server.csproj" />
      <ProjectReference Include="..\Dav.AspNetCore.Server.Extensions.Ado\Dav.AspNetCore.Server.Extensions.Ado.csproj">
          <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
          <IncludeAssets>Dav.AspNetCore.Server.Extensions.Ado.dll</IncludeAssets>
      </ProjectReference>
    </ItemGroup>

    <Target DependsOnTargets="ResolveReferences" Name="CopyProjectReferencesToPackage">
        <ItemGroup>
            <!-- Only bundle the non-packable Ado helper; Dav.AspNetCore.Server flows as a package dependency. -->
            <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference')->WithMetadataValue('Filename', 'Dav.AspNetCore.Server.Extensions.Ado'))"/>
        </ItemGroup>
    </Target>

</Project>
